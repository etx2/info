#!/bin/bash
# info:
# Gives information about system

# cut string by character es. | cut -d ":" -f 1  | where : for example is the delimitator of the string and -f 1 return the first result
# cut first character of line es. | sed 's/.$//'
# cut last character of line es. | sed 's/^.//' 
# getting first line of string es. | head -1
# getting last line of string es. | tail -1  
# grep exclude es. | grep -v " " (es grep -V "FAILED" will not shot the result that contain FAILED
# cut string via awk es: | awk -F 'delimitator' '{print $1}' (delimitator is the caratcher who divide the string and $1 is the first result)
# remove first world doesnt metter how many space is in it: sed 's/[^ ]* *//'


function coloredEcho(){
    local exp=$1;
    local color=$2;
    if ! [[ $color =~ '^[0-9]$' ]] ; then
       case $(echo $color | tr '[:upper:]' '[:lower:]') in
        black) color=0 ;;
        red) color=1 ;;
        green) color=2 ;;
        yellow) color=3 ;;
        blue) color=4 ;;
        magenta) color=5 ;;
        cyan) color=6 ;;
        white|*) color=7 ;; # white or invalid color
       esac
    fi
    tput setaf $color;
    echo $exp;
    tput sgr0;
}

drawline() {
    printf "%*s" $(tput cols) | tr ' ' '.'
}

function system() {
    # SYSTEM INFO 
    coloredEcho "System info: " $separator
    echo `uname -v`
    coloredEcho "Uptime: `uptime`" $info 
    coloredEcho "Running process for all user: `ps ax | wc -l`" $info
    coloredEcho "Running process for user `whoami` : `ps x | wc -l`" $info
    coloredEcho "Hostname: $HOSTNAME" $info

    sleep 0.5
    coloredEcho "Ram / Swap : `free -mhL --si`" $info

}

function cpu_info(){
    # CPU INFO
    if command -v lscpu 2>&1 >/dev/null
    then
        coloredEcho "CPU Info: " $separator
        echo "-> lscpu present on system, getting information..."
        var=`lscpu | grep Vendor | cut -d ":" -f 2`
        coloredEcho "Cpu: $var" $info
        var=`lscpu | grep Model | cut -d ":" -f 2`
        coloredEcho "Model: $var" $info
        var=`cat /proc/cpuinfo | grep processor | wc -l`
        coloredEcho "Number of core: $var" $info
    else
        coloredEcho "Cannot get more information, lscpu is missing" $error
    fi
    if command -v python3 2>&1 >/dev/null
    then
        var=`printf "%b" "import psutil\nprint('{}%'.format(psutil.cpu_percent(interval=2)))" | python3`
        coloredEcho "Use percentage: $var" $info
    else
        coloredEcho "Cannot check percentage, python3 is missing" $error
    fi
}

function hardware_info(){
    # HARDWARE INFO
    if command -v lspci 2>&1 >/dev/null
    then 
        coloredEcho "Hardware Info: " $separator
        echo "-> lspci present on system, getting information..."
        coloredEcho "`lspci | grep VGA | awk '{$1= ":"; print $0}' | awk '{$1= " "; print $0}' `" $info
        coloredEcho "`lspci -nnk | grep VGA -A3 | tail -1`" $info
        coloredEcho "`lspci -nnk | grep VGA -A4 | tail -1`" $info
        coloredEcho "`lspci | grep audio | awk '{$1= ":"; print $0}' | awk '{$1= " "; print $0}' `" $info
        coloredEcho "`lspci -nnk | grep audio -A3 | tail -1`" $info
        coloredEcho "`lspci -nnk | grep audio -A4 | tail -1`" $info
        coloredEcho "`lspci | grep Network | awk '{$1= ":"; print $0}' | awk '{$1= " "; print $0}' `" $info
        coloredEcho "`lspci -nnk | grep Network -A3 | tail -1`" $info
        coloredEcho "`lspci -nnk | grep Network -A4 | tail -1`" $info
    else
        coloredEcho "Cannot get information, lspci is missing" $error
    fi
    if command -v dmidecode 2>&1 >/dev/null 
    then
        echo " " 
        coloredEcho "This part requires root privilege, running as sudo if is configured on system" $info
        if command -v sudo 2>&1 >/dev/null
        then 
            var=`whoami`
            [ "$UID" -eq 0 ] || exec sudo bash "$0" "-root" "-h"
        else
            coloredEccho "sudo isn't configured in your system" $error
        fi
        if [ "$UID" -eq 0 -o "$EUID" -eq 0 ]; then
            exec bash "$0" "-root" "-h"
        else
            coloredEcho "Try run as root" $error
            exit 1
        fi
        su $var
    fi
}

function hardware_info_root() {
    [ "$UID" -eq 0 ] || exit 1
    coloredEcho "Hardware manufacter: `dmidecode -s system-manufacturer`" $info
    coloredEcho "Product name: `dmidecode -s system-product-name`" $info
    exit 1
}

function temperature_info() {
    #TEMPERATURE INFO
    coloredEcho "Temperature Info: " $separator
    paste <(cat /sys/class/thermal/thermal_zone*/type) <(cat /sys/class/thermal/thermal_zone*/temp) | column -s $'\t' -t | sed 's/\(.\)..$/.\1°C/' >>/tmp/temperature
    var=`wc -l /tmp/temperature | cut -d " " -f 1`
    echo "-> Number of sensor in system: $var"
    x=1; while  [ $x -le $var ]; do coloredEcho "`cat /tmp/temperature | head -n $x | tail -1 `" $info $(( x++ )); done
    rm /tmp/temperature
    if command -v sensors 2>&1 >/dev/null
    then
        coloredEcho "sensors is present, should be useful to run sensor for pretty result" green
    else
        coloredEcho "sensors is not present on the system, it can be installed using package manager" $error
    fi
}

function disk_info(){
    # DISK INFO
    if command -v df 2>&1 >/dev/null
    then
        coloredEcho "Disk info: " $separator
        echo "-> df present, getting information... "
        var=`df / | grep / | cut -d" " -f1`
        coloredEcho "Root Device: $var" $info
        coloredEcho "Disk space: `df $var -h | sed -n 2p | cut -d " " -f 3`" $info
        coloredEcho "Used: `df $var -h | sed -n 2p | cut -d " " -f 6`" $info
        coloredEcho "Free: `df $var -h | sed -n 2p | cut -d " " -f 10`" $info
        if command -v blkid 2>&1 >/dev/null
        then 
            var=`blkid $var | grep UUID | cut -d" " -f3 | cut -d "=" -f 2 | sed 's/.$//' | sed 's/^.//' | head -1`
            coloredEcho "UUID: $var" $info
        else
            coloredEcho "Cannot get information, blkid is missing" $error
        fi
        if command -v lsblk 2>&1 >/dev/null
        then 
            var=`lsblk | grep disk | wc -l`
            coloredEcho "Disk on device, using lsblk: $var" $info
            x=1; while  [ $x -le $var ]; do coloredEcho "Disk $x : `lsblk | grep disk | head -n $x | tail -1 | cut -d " " -f 1`" $info $(( x++ )); done
        else    
            coloredEcho "Cannot get information, lsblk is missing" $error
        fi
    else
        coloredEcho "Cannot get information, df is missing" $error
    fi
}

function lan_info(){
    # LAN INFO
    if command -v route 2>&1 >/dev/null
    then
        coloredEcho "LAN info: " $separator
        var=`route -n | grep 'UG[ \t]' | awk '{print $2}'`
        if ping -c 1 $var &> /dev/null
        then
            echo "-> Lan connected... Getting lan information... "
            coloredEcho "Gateway: $var" $info
            var=`ifconfig | grep -Eo 'inet (addr:)?([0-9]*\.){3}[0-9]*' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '127.0.0.1'`
            coloredEcho "Local ip address: $var" $info
            var=`route | grep default | awk '{print $8}'`
            coloredEcho "Local interface: $var" $info
            coloredEcho "`nmcli -f CAPABILITIES.SPEED dev show $var`" $info
        else
            coloredEcho "No LAN Connection found" $error
        fi
    else
        coloredEcho "Cannot get network information, route is missing" $error
    fi
    sleep 0.5
    if $network 
    then
        coloredEcho "Selected for network information" yellow
        if command -v ip 2>&1 >/dev/null
        then
            coloredEcho "Scanning for local network device: " $success
            var=`route -n | grep 'UG[ \t]' | awk '{print $2}'`
            var="${var}/24"
            coloredEcho $var $info
            nmap -sn $var  &> /dev/null 
            var=`ip -r n | grep -v FAILED`
            coloredEcho "Number of online device: `ip n | grep -v FAILED | wc -l`" $info
        else
            coloredEcho "Cannot scan due missing nmap software " $error
        fi
    fi
        sleep 0.5
}

function network_info() {
    # NETWORK INFO 
    if command -v ip 2>&1 >/dev/null
    then
        coloredEcho "Network info: " $separator
        if ping -c 1 8.8.8.8 &> /dev/null
        then
            coloredEcho "-> Online... getting information" $success
            var=`ip route get 8.8.8.8 | sed -n 's/.* dev \([^\ ]*\) .*/\1/p'`
            coloredEcho "Internet interface: $var" $info
            var=`dig -4 TXT +short o-o.myaddr.l.google.com @ns1.google.com | sed 's/.$//' | sed 's/^.//' `
            coloredEcho "Pubblic ip address: $var" $info 
            # Localization
            if ping -c 1 ipinfo.io &> /dev/null
            then 
                curl -s ipinfo.io >> /tmp/ipinfo.io 
                coloredEcho "Country: `cat /tmp/ipinfo.io | grep "country" | awk -F '"' '{print $4}'`" $info #country
                coloredEcho "Region: `cat /tmp/ipinfo.io | grep "region" | awk -F '"' '{print $4}'`" $info #Region
                coloredEcho "City: `cat /tmp/ipinfo.io | grep "city" | awk -F '"' '{print $4}'`" $info #City
                coloredEcho "Hostname: `cat /tmp/ipinfo.io | grep "hostname" | awk -F '"' '{print $4}'`" $info #hostname
                coloredEcho "Longitude, Latitude: `cat /tmp/ipinfo.io | grep "loc" | awk -F '"' '{print $4}'`" $info #loc
                coloredEcho "Timezone: `cat /tmp/ipinfo.io | grep "timezone" | awk -F '"' '{print $4}'`" $info #timezone
                rm /tmp/ipinfo.io
            else
                coloredEcho "Cannot receive information from ipinfo.io" $error
            fi
            if $network
            then
                coloredEcho "Testing network speed: " $info
                t=$(date +"%s"); wget http://speedtest.tele2.net/100MB.zip -T 1 -O  - >/dev/null 2>&1; echo -n "MBit/s: "; expr 8 \* 100 / $(($(date +"%s")-$t))
            fi
            else
            coloredEcho "Not connected to internet, unable to test speed" $error
        fi
    else
        coloredEcho "Cannot get network information, ip is missing" $error
    fi
    sleep 0.5
    echo " "
}

