function software_info() {
    # SOFTWARE INFO
    sleep 0.5
    echo " " 
    coloredEcho "Selected for Software information" yellow
    coloredEcho "Operating system: `cat /etc/os-release | grep PRETTY_NAME | cut -d "=" -f 2 | sed 's/^.//' | sed 's/.$//'`" $info
    coloredEcho "Desktop session: $DESKTOP_SESSION" $info
    coloredEcho "Desktop engine: $XDG_CURRENT_DESKTOP" $info
    coloredEcho "Desktop server: $XDG_SESSION_TYPE" $info
    if systemctl --user status pulseaudio.service pulseaudio.socket &>/dev/null
    then
            coloredEcho "Audio server found: pulseaudio" $info
    fi
    if systemctl --user status pipewire.socket pipewire.service  &>/dev/null
    then
            coloredEcho "Audio server found: pipewire" $info
    fi
    if command -v cmake 2>&1 >/dev/null
    then
        coloredEcho "Cmake present, version: `cmake --version | head -1 | cut -d " " -f 3`" $info
    fi
    if command -v qmake 2>&1 >/dev/null
        then
        coloredEcho "Qtmake present, version: `qmake --version | head -1 | cut -d " " -f 3`" $info
        coloredEcho "Qt version : `qmake --version | tail -1 | cut -d " " -f 4` " $info
    fi
    if command -v qmake6 2>&1 >/dev/null
        then
        coloredEcho "QT6 present, version: `qmake6 --version | tail -1 | cut -d " " -f 4` " $info
    fi
}

function systemd_info() {
    # SYSTEMD iNFO
    echo " " 
    coloredEcho "Selected for Systemd information" yellow
    coloredEcho "`systemd-analyze | head -1`" $info
    coloredEcho "`systemd-analyze | tail -1`" $info
    echo "-> Analyzing boot chain"
    systemd-analyze critical-chain
}

function benchmark() {
    # BENCHMARK
    echo " "
    coloredEcho "Selected for benchmark" yellow
    # Setting performance
    if command -v sudo 2>&1 >/dev/null
    then 
        [ "$UID" -eq 0 ] || exec sudo bash "$0" "-root" "-b"
    else
        coloredEccho "sudo isn't configured in your system" $error
    fi
    if [ "$UID" -eq 0 -o "$EUID" -eq 0 ]; then
        exec bash "$0" "-root" "-b"
    else
        coloredEcho "Try run as root" $error
        exit 1
    fi
    exit
}

function benchmark_root(){
    var=`cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor`
    coloredEcho "Scaling_governor value: $var" magenta
    if [ "$UID" -eq 0 -o "$EUID" -eq 0 ]; then
        coloredEcho "Run as root, proceding" $fine
        coloredEcho "Setting parameters performance in scaling_governor" $info
        echo performance | tee /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    else
        exit 1
    fi
    echo " "     
    coloredEcho "This benchmark use all the core in order to check the write/read speed" $info
    coloredEcho "Measuring (in times) how long the system takes to sha312sum 10GB of zeros:" $info
    dd if=/dev/zero bs=1MB count=10240 | sha512sum 
    coloredEcho "Measuring root device writing speed, device: `df / | grep / | cut -d" " -f1`" $info
    dd if=/dev/zero of=/tmp/temp bs=1M count=2048 conv=fdatasync,notrunc status=progress
    coloredEcho "Measuring reading speed" $info
    dd if=/tmp/temp of=/dev/null bs=1M count=2048 status=progress
    coloredEcho "Measuring reading speed by buffer cache" $info
    dd if=/tmp/temp of=/dev/null bs=1M count=2048 status=progress
    #removing file
    rm /tmp/temp
    coloredEcho "Measuring performance in a loop cycle" $info
    coloredEcho "This benchmark assign single core to the task" $info
    taskset -c 0 bash -c 'x=0; time while ((x < 999999)); do ((++x)); done'
    #removing performance
    coloredEcho "restoring parameters $var in scaling_governor" $info
    echo $var | tee /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 
    exit
}

